{
  "name": "rss-combiner",
  "version": "1.1.0",
  "author": "RSS Combiner Template",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaredcat/rss-combiner.git"
  },
  "module": "index.ts",
  "scripts": {
    "wrangler": "wrangler",
    "setup": "bun run scripts/setup.ts",
    "ensure-kv-ci": "bun run scripts/ensure-kv-ci.ts",
    "ensure-queue-ci": "bun run scripts/ensure-queue-ci.ts",
    "upload-cover": "bun run scripts/upload-cover.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler build",
    "generate": "bun run scripts/generate-xml.ts > podcasts.xml",
    "test-local": "bun run scripts/generate-xml.ts | head -50",
    "test": "bun test",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix && tsc --noEmit"
  },
  "dependencies": {
    "@codekitties/workers-mini-admin": "^0.1.1",
    "fast-xml-parser": "^5.11.2",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@eslint/js": "^10.0.1",
    "@iarna/toml": "^2.2.5",
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "@types/rss": "^0.0.32",
    "eslint": "^10.12.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.147.0"
  },
  "description": "A Cloudflare Worker-based RSS feed combiner that merges multiple podcast feeds into a single, unified feed",
  "keywords": [
    "rss",
    "podcast",
    "feed",
    "combiner",
    "cloudflare",
    "workers",
    "r2"
  ],
  "license": "AGPL-3.0-only",
  "type": "module"
}
