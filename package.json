{
  "name": "rss-combiner",
  "version": "2.0.0",
  "author": "RSS Combiner Template",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaredcat/rss-combiner.git"
  },
  "module": "index.ts",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "wrangler": "wrangler",
    "setup": "tsx scripts/setup.ts",
    "ensure-kv-ci": "tsx scripts/ensure-kv-ci.ts",
    "ensure-queue-ci": "tsx scripts/ensure-queue-ci.ts",
    "upload-cover": "tsx scripts/upload-cover.ts",
    "dev": "tsx scripts/wrangler-with-local.ts dev",
    "deploy": "tsx scripts/wrangler-with-local.ts deploy",
    "build": "tsx scripts/wrangler-with-local.ts build",
    "generate": "tsx scripts/generate-xml.ts > feed.xml",
    "test-local": "tsx scripts/generate-xml.ts | head -50",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "rss": "^1.2.2",
    "workers-mini-admin": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/node": "^26.6.4",
    "@types/rss": "^0.0.32",
    "eslint": "^10.12.0",
    "eslint-config-narwhal": "^2.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "smol-toml": "^1.9.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "description": "A Cloudflare Worker-based RSS feed combiner that merges multiple RSS 2.0 feeds into one podcast or generic feed",
  "keywords": [
    "rss",
    "podcast",
    "feed",
    "combiner",
    "workers",
    "cloudflare",
    "r2"
  ],
  "license": "AGPL-3.0-only",
  "type": "module"
}
